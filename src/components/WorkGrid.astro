---
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';
import { displayName, isPersonal } from '../lib/work';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = entries.filter((entry) => entry.data.featured);
const more = entries.filter((entry) => !entry.data.featured);
---

<section id="work" class="px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-baseline justify-between border-b border-border pb-6">
      <h2 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">Featured work</h2>
      <p class="text-sm text-fg-subtle">{featured.length} case studies</p>
    </div>

    <div>
      {featured.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>

    {
      more.length > 0 && (
        <div class="mt-16 border-t border-border pt-10">
          <h3 class="text-sm font-medium text-fg-muted">More work</h3>
          <ul class="mt-4 divide-y divide-border border-y border-border">
            {more.map((entry) => (
              <li>
                <a
                  href={`/work/${entry.id}`}
                  class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                >
                  <span class="text-fg transition-colors group-hover:text-accent">
                    {displayName(entry)}
                    <span class="text-fg-subtle"> &middot; {isPersonal(entry) ? 'Personal project' : entry.data.category}</span>
                  </span>
                  <span class="flex items-baseline justify-between gap-4 text-sm text-fg-subtle sm:justify-end">
                    {entry.data.year}
                    <span aria-hidden="true" class="transition-colors group-hover:text-accent">&rarr;</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
