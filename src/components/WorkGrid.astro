---
import { getCollection } from 'astro:content';
import CaseStudyCard from './CaseStudyCard.astro';

const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<section id="work" class="px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-baseline justify-between border-b border-border pb-6">
      <h2 class="text-sm text-fg-subtle">Featured work</h2>
      <p class="text-sm text-fg-subtle">2018&ndash;2026</p>
    </div>

    <div>
      {entries.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </div>
</section>
