---
const experience = [
  { company: 'Universal Technical Institute', role: 'Senior Product Designer', period: 'April 2024 – Current' },
  { company: 'Medable', role: 'Senior Product Designer (Part-Time Contract)', period: 'April 2025 – November 2025' },
  { company: 'Drips', role: 'Senior Product Designer (Part-Time Contract)', period: 'January 2025 – June 2025' },
  { company: 'Freelance', role: 'Product Designer', period: 'February 2023 – March 2024' },
  { company: 'Sibi', role: 'Lead Product Designer', period: 'March 2022 – February 2023' },
];

const services = [
  'Product design',
  'Design systems',
  'UX research',
  'Websites and mobile app design',
  'Frontend development',
];
---

<section id="about" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto grid max-w-6xl gap-16 sm:grid-cols-12">
    <div class="sm:col-span-4">
      <h2 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">About me</h2>
    </div>

    <div class="space-y-5 text-lg leading-relaxed text-fg-muted sm:col-span-8">
      <p>
        I design and build products where mistakes matter: clinical trial platforms,
        HIPAA-compliant medical devices, intake systems for a children&rsquo;s clinic. Most of
        that work starts as a mess. A missing feature becomes a support team&rsquo;s problem. A
        form fights the phone call it should support. Nobody trusts the dashboard. I spend most
        of my time there, not in Figma, on purpose.
      </p>
      <p>
        After fifteen years, I still design products and build them myself. I run the research
        and draw the wireframes. Then I write the React and TypeScript code that ships. If
        someone else does that work, I lose the details that matter.
      </p>
      <p class="text-fg">
        I worked across game studios, civic tech, healthcare, and enterprise software. The
        industries change. The job stays the same. I find out what is actually broken. Then I fix
        that, not whatever is easiest to redesign.
      </p>
    </div>

    <div class="sm:col-span-4">
      <h3 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">Experience</h3>
    </div>
    <div class="sm:col-span-8">
      <ul class="divide-y divide-border border-y border-border">
        {
          experience.map((job) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:justify-between">
              <div>
                <p class="text-fg">{job.company}</p>
                <p class="text-sm text-fg-muted">{job.role}</p>
              </div>
              <p class="text-sm text-fg-subtle">{job.period}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-4">
      <h3 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">Services</h3>
    </div>
    <div class="sm:col-span-8">
      <ul class="grid gap-3 sm:grid-cols-2">
        {
          services.map((service) => (
            <li class="rounded-lg border border-border px-4 py-3 text-fg-muted">{service}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
