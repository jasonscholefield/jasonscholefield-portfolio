---
import SmartImage from '../SmartImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  images: (ImageMetadata | string)[];
  imageAlt: string;
  caption?: string;
}

const { heading, images, imageAlt, caption } = Astro.props;
---

<div class="not-prose relative left-1/2 right-1/2 -mx-[50vw] w-screen px-6 py-10 sm:px-8 sm:py-16">
  <div class="mx-auto max-w-6xl">
    <h3 class="max-w-2xl text-2xl font-medium tracking-tight text-fg">{heading}</h3>
    <div class="mt-4 max-w-2xl space-y-4 text-base leading-relaxed text-fg-muted">
      <slot />
    </div>

    <div class="mt-10 flex flex-wrap gap-6">
      {
        images.map((img, i) => (
          <div
            class={`min-w-[240px] flex-1 overflow-hidden ${i % 2 === 1 ? 'sm:translate-y-6' : ''}`}
          >
            <SmartImage src={img} alt={imageAlt} width={700} lightbox class="aspect-[4/3] w-full object-cover" />
          </div>
        ))
      }
    </div>

    {caption && <p class="mt-8 text-center text-sm text-fg-subtle italic">{caption}</p>}
  </div>
</div>
