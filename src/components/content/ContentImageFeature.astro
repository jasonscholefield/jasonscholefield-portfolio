---
import SmartImage from '../SmartImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  image: ImageMetadata | string;
  imageAlt: string;
  preserveAspect?: boolean;
}

const { heading, image, imageAlt, preserveAspect = false } = Astro.props;
---

<div class="not-prose relative left-1/2 right-1/2 -mx-[50vw] w-screen px-6 py-10 sm:px-8 sm:py-16">
  <div class="mx-auto max-w-6xl">
    {
      preserveAspect ? (
        <SmartImage src={image} alt={imageAlt} width={2400} lightbox class="h-auto w-full" />
      ) : (
        <div class="aspect-video w-full overflow-hidden">
          <SmartImage src={image} alt={imageAlt} width={2400} lightbox class="h-full w-full object-cover object-top" />
        </div>
      )
    }
    <div class="mx-auto mt-8 max-w-3xl sm:mt-12">
      <h3 class="text-2xl font-medium tracking-tight text-fg">{heading}</h3>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-fg-muted">
        <slot />
      </div>
    </div>
  </div>
</div>
