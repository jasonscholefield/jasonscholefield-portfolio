---
interface Props {
  heading?: string;
  goals?: { title: string; description: string }[];
  fields?: { label: string; value: string }[];
}

const { heading = 'Overview', goals, fields } = Astro.props;
const hasFields = fields && fields.length > 0;
---

<div class="not-prose relative left-1/2 right-1/2 -mx-[50vw] w-screen px-6 py-10 sm:px-8 sm:py-16">
  <div class={`mx-auto max-w-6xl grid gap-10 sm:gap-16 ${hasFields ? 'sm:grid-cols-[1.3fr_1fr]' : ''}`}>
    <div class={hasFields ? '' : 'max-w-2xl'}>
      <h3 class="text-2xl font-medium tracking-tight text-fg">{heading}</h3>
      <div class="mt-4 space-y-4 text-base leading-relaxed text-fg-muted">
        <slot />
      </div>

      {
        goals && goals.length > 0 && (
          <div class="mt-8">
            <p class="text-sm font-medium text-fg">Goals</p>
            <ol class="mt-3 space-y-3">
              {goals.map((g, i) => (
                <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
                  <span class="text-fg-subtle">{i + 1}.</span>
                  <span>
                    <strong class="font-medium text-fg">{g.title}</strong> {g.description}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>

    {
      hasFields && (
        <dl class="divide-y divide-border border-y border-border">
          {fields!.map((f) => (
            <div class="grid grid-cols-[110px_1fr] gap-4 py-4">
              <dt class="text-xs tracking-wide text-fg-subtle uppercase">{f.label}</dt>
              <dd class="text-sm leading-relaxed text-fg">{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</div>
