---
import SmartImage from './SmartImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  images?: (ImageMetadata | string)[];
  alt: string;
}

const { images, alt } = Astro.props;
---

{
  images && images.length > 0 && (
    <div class="px-6 pt-6 sm:px-8">
      <div class="mx-auto flex max-w-6xl flex-col gap-2.5">
        {images.map((src) => (
          <div class="aspect-[4/3] w-full overflow-hidden sm:aspect-video">
            <SmartImage src={src} alt={alt} width={2400} lightbox class="h-full w-full object-cover object-top" />
          </div>
        ))}
      </div>
    </div>
  )
}
