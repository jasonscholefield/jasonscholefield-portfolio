---
---

<div
  id="lightbox"
  class="fixed inset-0 z-100 hidden flex-col items-center justify-center gap-4 bg-bg/95 p-4 backdrop-blur-sm sm:p-8"
  role="dialog"
  aria-modal="true"
  aria-label="Image preview"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Close image preview"
    class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full border border-border-strong bg-bg text-fg transition-colors hover:border-accent hover:text-accent sm:top-6 sm:right-6"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>
  <div id="lightbox-compare-toggle" class="hidden gap-3">
    <button type="button" id="lightbox-before-btn" class="min-w-[96px] rounded-full border border-border-strong px-7 py-3 text-base font-medium text-fg-muted transition-colors" data-choice="before"></button>
    <button type="button" id="lightbox-after-btn" class="min-w-[96px] rounded-full border border-border-strong px-7 py-3 text-base font-medium text-fg-muted transition-colors" data-choice="after"></button>
  </div>
  <img id="lightbox-img" src="" alt="" class="max-h-[75vh] max-w-full object-contain" />
</div>

<script>
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('lightbox-close');
  const compareToggle = document.getElementById('lightbox-compare-toggle');
  const beforeBtn = document.getElementById('lightbox-before-btn');
  const afterBtn = document.getElementById('lightbox-after-btn');

  if (lightbox && lightboxImg && closeBtn && compareToggle && beforeBtn && afterBtn) {
    let compareSrcs: { before: string; after: string } | null = null;

    const setActiveCompareButton = (choice: 'before' | 'after') => {
      [beforeBtn, afterBtn].forEach((btn) => {
        const active = btn.dataset.choice === choice;
        btn.classList.toggle('border-accent', active);
        btn.classList.toggle('text-accent', active);
        btn.classList.toggle('border-border-strong', !active);
        btn.classList.toggle('text-fg-muted', !active);
      });
    };

    const open = (src: string, alt: string) => {
      lightboxImg.src = src;
      lightboxImg.alt = alt;
      compareToggle.classList.add('hidden');
      compareToggle.classList.remove('flex');
      compareSrcs = null;
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const openCompare = (opts: { beforeSrc: string; afterSrc: string; beforeLabel: string; afterLabel: string; alt: string }) => {
      compareSrcs = { before: opts.beforeSrc, after: opts.afterSrc };
      beforeBtn.textContent = opts.beforeLabel;
      afterBtn.textContent = opts.afterLabel;
      lightboxImg.src = opts.afterSrc;
      lightboxImg.alt = opts.alt;
      setActiveCompareButton('after');
      compareToggle.classList.remove('hidden');
      compareToggle.classList.add('flex');
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const close = () => {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightboxImg.src = '';
      compareToggle.classList.add('hidden');
      compareToggle.classList.remove('flex');
      compareSrcs = null;
      document.body.style.overflow = '';
    };

    const openFromTrigger = (trigger: HTMLElement) => {
      const src = trigger.getAttribute('data-lightbox-src');
      const alt = trigger.getAttribute('data-lightbox-alt') ?? '';
      if (!src) return;

      if (trigger.getAttribute('data-lightbox-compare') === 'true') {
        openCompare({
          beforeSrc: trigger.getAttribute('data-lightbox-before-src') ?? src,
          afterSrc: trigger.getAttribute('data-lightbox-after-src') ?? src,
          beforeLabel: trigger.getAttribute('data-lightbox-before-label') ?? 'Before',
          afterLabel: trigger.getAttribute('data-lightbox-after-label') ?? 'After',
          alt,
        });
      } else {
        open(src, alt);
      }
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-src]');
      if (trigger) {
        e.preventDefault();
        openFromTrigger(trigger);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'Enter' || e.key === ' ') {
        const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox-src]');
        if (trigger) {
          e.preventDefault();
          openFromTrigger(trigger);
        }
      }
    });

    [beforeBtn, afterBtn].forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!compareSrcs) return;
        const choice = btn.dataset.choice === 'before' ? 'before' : 'after';
        lightboxImg.src = compareSrcs[choice];
        setActiveCompareButton(choice);
      });
    });

    closeBtn.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
  }
</script>
