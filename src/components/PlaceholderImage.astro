---
interface Props {
  seed?: string;
  class?: string;
}

const { seed = 'default', class: className = '' } = Astro.props;

// Deterministic pseudo-random angle/stops per card so placeholders aren't identical.
let hash = 0;
for (const char of seed) hash = (hash * 31 + char.charCodeAt(0)) >>> 0;
const angle = 25 + (hash % 90);
const colors = ['var(--color-hero-1)', 'var(--color-hero-2)', 'var(--color-hero-3)'];
const from = colors[hash % 3];
const to = colors[(hash + 1) % 3];
---

<div
  class={`relative flex items-center justify-center overflow-hidden bg-bg-elevated ${className}`}
  style={`background-image: linear-gradient(${angle}deg, ${from}22, ${to}22);`}
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-fg-subtle">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="9" cy="10" r="1.75" />
    <path d="m3 17 5.5-5.5a2 2 0 0 1 2.83 0L17 17" />
  </svg>
</div>
