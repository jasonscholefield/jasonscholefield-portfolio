---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { client, title, summary, category, tags, year, stats, liveUrl } = entry.data;
---

<article class="group border-t border-border py-10 first:border-t-0 sm:py-12">
  <div class="grid gap-8 sm:grid-cols-12 sm:gap-6">
    <div class="sm:col-span-4">
      <p class="text-sm text-fg-subtle">{year}</p>
      <h3 class="mt-2 text-lg font-medium text-fg">{client}</h3>
      <p class="mt-1 text-sm text-fg-muted">{category}</p>

      <ul class="mt-4 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li class="rounded-full border border-border-strong px-3 py-1 text-xs text-fg-muted">
              {tag}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="sm:col-span-5">
      <h4 class="text-xl leading-snug text-fg sm:text-2xl">{title}</h4>
      <p class="mt-3 text-sm leading-relaxed text-fg-muted">{summary}</p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={`/work/${entry.id}`}
          class="inline-flex items-center gap-2 text-sm text-fg transition-colors group-hover:text-accent"
        >
          View case study <span aria-hidden="true">&rarr;</span>
        </a>
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-fg-muted transition-colors hover:text-fg"
            >
              View live <span aria-hidden="true">&#8599;</span>
            </a>
          )
        }
      </div>
    </div>

    <div class="sm:col-span-3">
      {
        stats && stats.length > 0 && (
          <dl class="grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-1">
            {stats.map((stat) => (
              <div>
                <dt class="text-xs text-fg-subtle">{stat.label}</dt>
                <dd class="mt-1 text-lg font-medium text-accent">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</article>
