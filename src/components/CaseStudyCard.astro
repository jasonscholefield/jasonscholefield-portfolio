---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { client, title, summary, category, tags, year, stats, liveUrl, coverImage } = entry.data;
---

<article class="group relative -mx-4 border-t border-border py-10 transition-colors first:border-t-0 hover:bg-bg-elevated sm:-mx-6 sm:py-12">
  <div class="flex flex-col gap-8 px-4 sm:flex-row sm:px-6">
    <div class="h-72 shrink-0 overflow-hidden rounded-lg border border-border sm:h-auto sm:w-2/5">
      {
        coverImage ? (
          <Image src={coverImage} alt="" width={1000} height={1000} class="h-full w-full object-cover" />
        ) : (
          <PlaceholderImage seed={entry.id} class="h-full w-full" />
        )
      }
    </div>

    <div class="flex flex-1 flex-col">
      <p class="text-sm text-fg-subtle">{year} &middot; {category}</p>
      <h3 class="mt-2 text-lg font-medium text-fg">{client}</h3>

      <ul class="mt-4 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li class="rounded-full border border-border-strong px-3 py-1 text-xs text-fg-muted">
              {tag}
            </li>
          ))
        }
      </ul>

      <h4 class="mt-6 text-xl leading-snug text-fg sm:text-2xl">{title}</h4>
      <p class="mt-3 text-sm leading-relaxed text-fg-muted">{summary}</p>

      <div class="mt-6 flex flex-wrap gap-4">
        <a
          href={`/work/${entry.id}`}
          class="inline-flex items-center gap-2 text-sm text-fg transition-colors group-hover:text-accent after:absolute after:inset-0 after:content-['']"
        >
          View case study <span aria-hidden="true">&rarr;</span>
        </a>
        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="relative z-10 inline-flex items-center gap-2 text-sm text-fg-muted transition-colors hover:text-fg"
            >
              View live <span aria-hidden="true">&#8599;</span>
            </a>
          )
        }
      </div>

      {
        stats && stats.length > 0 && (
          <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4 border-t border-border pt-6">
            {stats.map((stat) => (
              <div>
                <dt class="text-xs text-fg-subtle">{stat.label}</dt>
                <dd class="mt-1 text-lg font-medium text-accent">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</article>
