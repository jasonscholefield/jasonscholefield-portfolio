---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<footer id="contact" class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:px-8">
    <h2 class="max-w-2xl text-3xl font-medium tracking-tight text-fg sm:text-4xl">
      Interested in creating something impactful?
      <span class="text-fg-muted">Get in touch.</span>
    </h2>
    <a
      href="mailto:jasonscholefield@gmail.com?subject=Inquiry%20from%20Portfolio"
      class="mt-8 inline-flex items-center gap-2 text-lg text-accent transition-opacity hover:opacity-80"
    >
      jasonscholefield@gmail.com
      <span aria-hidden="true">&rarr;</span>
    </a>

    <div class="mt-20 flex flex-col gap-6 border-t border-border pt-8 sm:flex-row sm:items-center sm:justify-between">
      <ul class="flex flex-wrap gap-6">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-fg-muted transition-colors hover:text-fg">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="flex gap-6">
        <li>
          <a
            href="https://www.linkedin.com/in/jasonscholefield/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-fg-muted transition-colors hover:text-fg"
          >
            LinkedIn
          </a>
        </li>
      </ul>
      <p class="text-sm text-fg-subtle">Jason Scholefield &middot; {new Date().getFullYear()}</p>
    </div>
  </div>
</footer>
