---
import SmartImage from './SmartImage.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  alt: string;
  captions?: string[];
  constrainHeight?: boolean;
}

const { images, alt, captions, constrainHeight = false } = Astro.props;
const ratio = `${images[0].width} / ${images[0].height}`;
const ratioValue = images[0].width / images[0].height;
---

<div class="not-prose relative left-1/2 right-1/2 -mx-[50vw] w-screen px-6 py-10 sm:px-8 sm:py-16">
  <div class="mx-auto max-w-6xl">
    <div
      class="click-slider relative w-full overflow-hidden rounded-xl border border-border select-none"
      class:list={{ 'constrain-height': constrainHeight }}
      style={`aspect-ratio: ${ratio}; --slide-ratio: ${ratioValue};`}
    >
      {
        images.map((img, i) => (
          <div class="click-slide absolute inset-0" data-index={i} class:list={{ 'is-active': i === 0 }}>
            <SmartImage src={img} alt={`${alt} (slide ${i + 1} of ${images.length})`} width={2400} class="h-full w-full object-cover object-top" />
          </div>
        ))
      }

      <button type="button" class="group absolute inset-y-0 left-0 flex w-1/2 cursor-pointer items-center justify-start pl-4 sm:pl-6" aria-label="Previous slide">
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-fg/80 bg-bg/80 text-fg opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 18 9 12l6-6" />
          </svg>
        </span>
      </button>
      <button type="button" class="group absolute inset-y-0 right-0 flex w-1/2 cursor-pointer items-center justify-end pr-4 sm:pr-6" aria-label="Next slide">
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-fg/80 bg-bg/80 text-fg opacity-0 backdrop-blur transition-opacity group-hover:opacity-100">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </span>
      </button>

      <div class="click-hint pointer-events-none absolute inset-0 z-10 flex items-center justify-center bg-black/70 px-6 text-center">
        <p class="text-base font-medium text-white sm:text-lg">Tap the right side to navigate through the experience.</p>
      </div>
    </div>

    {
      captions && captions.length > 0 && (
        <div class="click-captions mt-4 grid">
          {captions.map((caption, i) => (
            <p class="click-caption text-center text-lg font-medium text-fg [grid-area:1/1]" data-index={i} class:list={{ 'is-active': i === 0 }}>
              {caption}
            </p>
          ))}
        </div>
      )
    }

    <div class="click-dots mt-4 flex flex-wrap items-center justify-center gap-2">
      {
        images.map((_, i) => (
          <button
            type="button"
            class="click-dot h-1.5 w-6 rounded-full transition-colors"
            data-index={i}
            class:list={{ 'bg-accent': i === 0, 'bg-border-strong': i !== 0 }}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))
      }
    </div>
    <p class="mt-3 text-center text-base text-fg-muted">
      Click the right half of the image to go forward, the left half to go back.
    </p>
  </div>
</div>

<style>
  .click-slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .click-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .click-caption {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .click-caption.is-active {
    opacity: 1;
    visibility: visible;
  }

  .click-hint {
    opacity: 1;
    transition: opacity 0.6s ease;
  }

  .click-hint.is-hidden {
    opacity: 0;
  }

  /* Contain within both the container width and 80vh, whichever is
     smaller, instead of cropping the image to fill a fixed height. */
  @media (min-width: 640px) {
    .click-slider.constrain-height {
      width: min(100%, calc(80vh * var(--slide-ratio)));
      margin-inline: auto;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.click-slider').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.click-slide'));
    const dotsRoot = slider.parentElement?.querySelector<HTMLElement>('.click-dots');
    const dots = dotsRoot ? Array.from(dotsRoot.querySelectorAll<HTMLButtonElement>('.click-dot')) : [];
    const captionsRoot = slider.parentElement?.querySelector<HTMLElement>('.click-captions');
    const captions = captionsRoot ? Array.from(captionsRoot.querySelectorAll<HTMLElement>('.click-caption')) : [];
    const prevBtn = slider.querySelector<HTMLButtonElement>('button[aria-label="Previous slide"]');
    const nextBtn = slider.querySelector<HTMLButtonElement>('button[aria-label="Next slide"]');
    let active = 0;

    const show = (index: number) => {
      active = index;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === active));
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-accent', i === active);
        dot.classList.toggle('bg-border-strong', i !== active);
      });
      captions.forEach((caption, i) => caption.classList.toggle('is-active', i === active));
    };

    // Next wraps from the last slide back to the first, but prev stops at
    // the first slide instead of looping back to the last, so it's clear
    // when there's nothing more behind.
    prevBtn?.addEventListener('click', () => show(Math.max(active - 1, 0)));
    nextBtn?.addEventListener('click', () => show((active + 1) % slides.length));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    // Show the "how to navigate" hint as soon as the slider scrolls into
    // view, then fade it out after it's had 1.5s to actually be seen.
    const hint = slider.querySelector<HTMLElement>('.click-hint');
    if (hint) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setTimeout(() => hint.classList.add('is-hidden'), 1500);
              observer.disconnect();
            }
          }
        },
        { threshold: 0.4 }
      );
      observer.observe(slider);
    }
  });
</script>
