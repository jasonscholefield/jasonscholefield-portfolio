---
export type IconName = 'eye' | 'target' | 'branch' | 'converge' | 'refresh' | 'scale' | 'compass' | 'layers';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-7 w-7' } = Astro.props;
---

<svg
  width="28"
  height="28"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {name === 'eye' && (
    <>
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
      <circle cx="12" cy="12" r="3" />
    </>
  )}
  {name === 'target' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="5" />
      <circle cx="12" cy="12" r="1" fill="currentColor" />
    </>
  )}
  {name === 'branch' && <path d="M12 3v7M12 10 6 19M12 10l6 9" />}
  {name === 'converge' && <path d="M7 7l3 3M17 7l-3 3M7 17l3-3M17 17l-3-3" />}
  {name === 'refresh' && <path d="M21 12a9 9 0 1 1-3-6.7M21 3v6h-6" />}
  {name === 'scale' && <path d="M12 3v18M7 7 3 15h8L7 7ZM17 7l-4 8h8l-4-8ZM5 15a2 2 0 0 0 4 0M15 15a2 2 0 0 0 4 0" />}
  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m14.5 9.5-2 5-5 2 2-5 5-2Z" />
    </>
  )}
  {name === 'layers' && <path d="m12 3 9 5-9 5-9-5 9-5ZM3 13l9 5 9-5" />}
</svg>
