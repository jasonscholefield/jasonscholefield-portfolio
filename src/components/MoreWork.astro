---
import { getCollection } from 'astro:content';
import { displayName, isPersonal } from '../lib/work';

const more = (await getCollection('work'))
  .filter((entry) => !entry.data.featured && !entry.data.sideProject)
  .sort((a, b) => a.data.order - b.data.order);
---

{
  more.length > 0 && (
    <section id="more-work" class="border-t border-border px-6 py-24 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <h2 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">More work</h2>
        <ul class="mt-8 divide-y divide-border border-y border-border">
          {more.map((entry) => (
            <li>
              <a
                href={`/work/${entry.id}`}
                class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <span class="text-fg transition-colors group-hover:text-accent">
                  {displayName(entry)}
                  <span class="text-fg-subtle"> &middot; {isPersonal(entry) ? 'Personal project' : entry.data.category}</span>
                </span>
                <span class="flex items-baseline justify-between gap-4 text-sm text-fg-subtle sm:justify-end">
                  {entry.data.year}
                  <span aria-hidden="true" class="transition-colors group-hover:text-accent">&rarr;</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
