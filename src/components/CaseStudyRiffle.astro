---
interface Props {
  entries: { id: string; label: string; meta: string }[];
  class?: string;
}

const { entries, class: className = '' } = Astro.props;

// Folder silhouette: a body with a notched tab whose position steps across the
// card, so the tabs of neighbouring cards never stack on top of each other.
const W = 250;
const H = 170;
const TAB = 24;
const TAB_X = [10, 52, 94];

const tabWidth = (label: string) => Math.min(W - 20, Math.max(100, Math.round(label.length * 7.4 + 62)));

const folderPath = (tx: number, tw: number) =>
  `M0.5 ${TAB + H - 1} V${TAB + 8} Q0.5 ${TAB} 8.5 ${TAB} H${tx - 6} Q${tx} ${TAB} ${tx + 2} ${TAB - 4} ` +
  `L${tx + 6} 7 Q${tx + 8} 1.5 ${tx + 14} 1.5 H${tx + tw - 14} Q${tx + tw - 8} 1.5 ${tx + tw - 6} 7 ` +
  `L${tx + tw - 2} ${TAB - 4} Q${tx + tw} ${TAB} ${tx + tw + 6} ${TAB} H${W - 8.5} Q${W - 0.5} ${TAB} ${W - 0.5} ${TAB + 8} ` +
  `V${TAB + H - 1} Z`;

// A small grid of dots at the end of each tab, like the original's punched marks.
const tabDots = (tx: number, tw: number) => {
  const dots: { cx: number; cy: number }[] = [];
  for (let row = 0; row < 2; row++) {
    for (let col = 0; col < 3; col++) {
      dots.push({ cx: tx + tw - 30 + col * 7, cy: 9 + row * 5 });
    }
  }
  return dots;
};
---

<nav aria-label="Featured case studies" class={`rf ${className}`} data-riffle>
  <div class="rf-stage">
    <div class="rf-plane">
      <i class="rf-marker" data-m="0" aria-hidden="true"></i>
      <i class="rf-marker" data-m="1" aria-hidden="true"></i>

      <div class="rf-ghost" aria-hidden="true"></div>
      <div class="rf-floor" aria-hidden="true"></div>
      <div class="rf-wall rf-wall-back" aria-hidden="true"></div>
      <div class="rf-wall rf-wall-left" aria-hidden="true"></div>

      {
        entries.map((entry, i) => {
          const tw = tabWidth(entry.label);
          const tx = Math.min(TAB_X[i % TAB_X.length], W - 10 - tw);
          return (
            <a class="rf-card" href={`/work/${entry.id}`} data-card style={`--i: ${i}; --tx: ${tx}px`}>
              <svg class="rf-shape" viewBox={`0 0 ${W} ${TAB + H}`} preserveAspectRatio="none" aria-hidden="true">
                <path d={folderPath(tx, tw)} />
                {tabDots(tx, tw).map((d) => (
                  <circle class="rf-dot" cx={d.cx} cy={d.cy} r="1" />
                ))}
              </svg>
              <span class="rf-label">{entry.label}</span>
              <span class="rf-meta">{entry.meta}</span>
              <span class="rf-arrow" aria-hidden="true">&rarr;</span>
            </a>
          );
        })
      }

      <div class="rf-wall rf-wall-right" aria-hidden="true"></div>
      <div class="rf-wall rf-wall-front" aria-hidden="true">
        <span class="rf-handle"></span>
      </div>
      <div class="rf-rim" aria-hidden="true"></div>
    </div>
  </div>
</nav>

<style>
  .rf {
    --rf-w: 250px;
    --rf-h: 170px;
    --rf-tab: 24px;
    --rf-gap: 44px;
    --rf-rest: -90deg;
    --rf-wall: 66px;
    --rf-pad-x: 14px;
    --rf-pad-front: 22px;
    --rf-pad-back: 14px;
    --rf-line: #5a5a62;
    --rf-long: calc(var(--rf-gap) * 7 + var(--rf-pad-front) + var(--rf-pad-back));
    width: 100%;
  }

  .rf-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    perspective: 2400px;
  }

  .rf-plane {
    position: absolute;
    left: 30%;
    top: 76%;
    scale: 1.18;
    width: var(--rf-w);
    height: 0;
    transform-style: preserve-3d;
    transform: translateX(-50%) rotateX(58deg) rotateZ(38deg);
  }

  @media (max-width: 1279px) {
    .rf-plane {
      left: 14%;
      scale: 0.8;
    }
  }

  @media (max-width: 639px) {
    .rf-stage {
      aspect-ratio: 4 / 3;
      margin-top: -4.5rem;
    }

    .rf-plane {
      left: 22%;
      top: 84%;
      scale: 0.7;
    }
  }

  .rf-marker {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 0;
    height: 0;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  /* Markers sit on the visible top strip of the resting cards 0 and 1, so the
     pointer maps to a card from static geometry, not from the moving cards. */
  .rf-marker[data-m='0'] {
    transform: translate3d(0, 0, 0) rotateX(var(--rf-rest)) translateY(calc(var(--rf-h) * -1 + 12px));
  }
  .rf-marker[data-m='1'] {
    transform: translate3d(0, calc(var(--rf-gap) * -1), 0) rotateX(var(--rf-rest)) translateY(calc(var(--rf-h) * -1 + 12px));
  }

  /* The bin: a floor, four walls of one height, and a rim that closes the top. */
  .rf-floor,
  .rf-ghost,
  .rf-rim {
    position: absolute;
    left: calc(var(--rf-pad-x) * -1);
    width: calc(100% + var(--rf-pad-x) * 2);
    bottom: calc(var(--rf-pad-front) * -1);
    height: var(--rf-long);
    border: 1px solid var(--rf-line);
    border-radius: 12px;
    pointer-events: none;
  }

  .rf-floor {
    background: #08080a;
    transform: translateZ(-1px);
  }

  /* A faint second outline under the bin, so it reads as sitting on a surface. */
  .rf-ghost {
    border-color: rgba(255, 255, 255, 0.08);
    transform: translateZ(-16px);
  }

  .rf-rim {
    transform: translateZ(var(--rf-wall));
    border-color: var(--rf-line);
    box-shadow:
      inset 0 0 0 7px #131316,
      inset 0 0 0 8px var(--rf-line);
  }

  .rf-wall {
    position: absolute;
    height: var(--rf-wall);
    bottom: 0;
    border: 1px solid var(--rf-line);
    background: linear-gradient(180deg, #141418, #0c0c0f);
    pointer-events: none;
  }

  .rf-wall-front {
    left: calc(var(--rf-pad-x) * -1);
    width: calc(100% + var(--rf-pad-x) * 2);
    border-radius: 4px 4px 12px 12px;
    transform-origin: 50% 100%;
    transform: translateY(var(--rf-pad-front)) rotateX(-90deg);
  }

  .rf-wall-back {
    left: calc(var(--rf-pad-x) * -1);
    width: calc(100% + var(--rf-pad-x) * 2);
    border-radius: 4px 4px 12px 12px;
    transform-origin: 50% 100%;
    transform: translateY(calc(var(--rf-gap) * -7 - var(--rf-pad-back))) rotateX(-90deg);
  }

  .rf-wall-right,
  .rf-wall-left {
    width: var(--rf-long);
    border-radius: 4px 4px 12px 12px;
    transform-origin: 0 100%;
    transform: translateY(var(--rf-pad-front)) rotateZ(-90deg) rotateX(-90deg);
  }

  .rf-wall-right {
    left: calc(100% + var(--rf-pad-x));
  }

  .rf-wall-left {
    left: calc(var(--rf-pad-x) * -1);
  }

  .rf-handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 14px;
    border: 1px solid var(--rf-line);
    border-radius: 999px;
    translate: -50% -50%;
  }

  .rf-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--rf-h);
    display: block;
    color: var(--color-fg);
    text-decoration: none;
    transform-origin: 50% 100%;
    transform: translate3d(0, calc(var(--rf-gap) * var(--i) * -1 + var(--ty, 0px)), var(--tz, 0px))
      rotateX(var(--a, var(--rf-rest)));
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
  }

  .rf-shape {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: calc(100% + var(--rf-tab));
    overflow: visible;
    fill: var(--color-bg);
    stroke: var(--rf-line);
    stroke-width: 1;
    transition:
      stroke 0.3s ease,
      fill 0.3s ease;
  }

  .rf-dot {
    fill: var(--color-fg-subtle);
    stroke: none;
  }

  .rf-card[data-active] .rf-shape {
    stroke: var(--color-accent);
    fill: var(--color-bg-elevated);
  }

  .rf-card:focus-visible {
    outline: none;
  }
  .rf-card:focus-visible .rf-shape {
    stroke: var(--color-accent);
  }

  /* Ruled lines under the title, like the front card in the original. */
  .rf-card::after {
    content: '';
    position: absolute;
    left: 16px;
    right: 16px;
    top: 20px;
    bottom: 40px;
    background: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 21px,
      var(--color-border) 21px,
      var(--color-border) 22px
    );
    pointer-events: none;
  }

  .rf-label {
    position: absolute;
    left: calc(var(--tx) + 14px);
    top: calc(var(--rf-tab) * -1 + 6px);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .rf-meta {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-size: 12px;
    color: var(--color-fg-subtle);
  }

  .rf-arrow {
    position: absolute;
    right: 16px;
    bottom: 11px;
    font-size: 18px;
    color: var(--color-fg-muted);
    transition: color 0.3s ease;
  }

  .rf-card[data-active] .rf-arrow {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .rf-card {
      transition: none;
    }
  }
</style>

<script>
  const REST = -90;
  const LIFT = 46;
  const PULL = 12;
  const LEAN = 13;

  document.querySelectorAll<HTMLElement>('[data-riffle]').forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-card]'));
    const m0 = root.querySelector<HTMLElement>('[data-m="0"]');
    const m1 = root.querySelector<HTMLElement>('[data-m="1"]');
    const stage = root.querySelector<HTMLElement>('.rf-stage');
    if (!m0 || !m1 || !stage || cards.length === 0) return;

    let active: number | null = null;

    const apply = (idx: number | null) => {
      active = idx;
      cards.forEach((card, i) => {
        if (idx === null) {
          card.style.setProperty('--a', `${REST}deg`);
          card.style.setProperty('--tz', '0px');
          card.style.setProperty('--ty', '0px');
          card.style.setProperty('--delay', '0ms');
          card.removeAttribute('data-active');
          return;
        }
        const d = i - idx; // negative: in front of the pulled card, positive: behind it
        const reach = Math.abs(d);
        let angle = REST;
        let tz = 0;
        let ty = 0;
        if (d === 0) {
          tz = LIFT;
          ty = PULL;
        } else if (d < 0) {
          // In front: lean forward, fading with distance.
          angle = REST - LEAN * Math.pow(0.7, reach - 1);
        } else {
          // Behind: lean back, fading with distance.
          angle = REST + LEAN * Math.pow(0.7, reach - 1);
        }
        card.style.setProperty('--a', `${angle}deg`);
        card.style.setProperty('--tz', `${tz}px`);
        card.style.setProperty('--ty', `${ty}px`);
        card.style.setProperty('--delay', `${reach * 40}ms`);
        if (d === 0) card.setAttribute('data-active', '');
        else card.removeAttribute('data-active');
      });
    };

    const centre = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
    };

    const indexAt = (clientX: number, clientY: number) => {
      const o = centre(m0);
      const n = centre(m1);
      const vx = n.x - o.x;
      const vy = n.y - o.y;
      const len = vx * vx + vy * vy || 1;
      const t = ((clientX - o.x) * vx + (clientY - o.y) * vy) / len;
      return Math.max(0, Math.min(cards.length - 1, Math.round(t)));
    };

    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const idx = indexAt(e.clientX, e.clientY);
      if (idx !== active) apply(idx);
    });
    stage.addEventListener('pointerleave', () => apply(null));

    // A click goes to the card that is pulled, which is the one the pointer is on.
    cards.forEach((card, i) => {
      card.addEventListener('click', (e) => {
        if (e.detail > 0 && active !== null && active !== i) {
          e.preventDefault();
          window.location.href = cards[active].href;
        }
      });
      card.addEventListener('focus', () => apply(i));
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) apply(null);
    });

    root.addEventListener('keydown', (e) => {
      const current = active ?? cards.findIndex((c) => c === document.activeElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        cards[Math.min(cards.length - 1, (current < 0 ? -1 : current) + 1)].focus();
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        cards[Math.max(0, (current < 0 ? cards.length : current) - 1)].focus();
      } else if (e.key === 'Escape') {
        (document.activeElement as HTMLElement | null)?.blur();
        apply(null);
      }
    });
  });
</script>
