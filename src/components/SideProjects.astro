---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { displayName } from '../lib/work';

interface Project {
  name: string;
  kicker: string;
  summary: string;
  tags: string[];
  stats?: { label: string; value: string }[];
  caseStudyUrl?: string;
  liveUrl?: string;
  image?: ImageMetadata;
}

// Side projects come from the work collection.
const fromWork: Project[] = (await getCollection('work'))
  .filter((entry) => entry.data.sideProject)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    name: displayName(entry),
    kicker: `${entry.data.year} · ${entry.data.category}`,
    summary: entry.data.summary,
    tags: entry.data.tags,
    stats: entry.data.stats?.slice(0, 2),
    caseStudyUrl: `/work/${entry.id}`,
    liveUrl: entry.data.liveUrl,
    image: entry.data.coverImage,
  }));

// Newest build first: lower `order` in the work frontmatter comes first.
const projects = fromWork;
---

<section id="side-projects" class="border-t border-border px-6 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-baseline justify-between border-b border-border pb-6">
      <h2 class="text-xl font-medium tracking-tight text-fg-muted sm:text-2xl">Side projects</h2>
      <p class="text-sm text-fg-subtle">Designed, built and shipped by me</p>
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        projects.map((project) => (
          <li class="group relative flex flex-col overflow-hidden rounded-lg border border-border transition-colors hover:bg-bg-elevated">
            {project.image && (
              <div class="aspect-[16/9] overflow-hidden border-b border-border">
                <Image
                  src={project.image}
                  alt={`Cover image for ${project.name}`}
                  width={900}
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <p class="text-sm text-fg-subtle">{project.kicker}</p>
              <h3 class="mt-2 text-xl font-medium text-fg">{project.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{project.summary}</p>

              <ul class="mt-4 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <li class="rounded-full border border-border-strong px-3 py-1 text-xs text-fg-muted">{tag}</li>
                ))}
              </ul>

              {project.stats && project.stats.length > 0 && (
                <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4 border-t border-border pt-5">
                  {project.stats.map((stat) => (
                    <div>
                      <dt class="text-xs text-fg-subtle">{stat.label}</dt>
                      <dd class="mt-1 text-lg font-medium text-accent">{stat.value}</dd>
                    </div>
                  ))}
                </dl>
              )}

              <div class="mt-auto flex flex-wrap gap-4 pt-6">
                {project.caseStudyUrl && (
                  <a
                    href={project.caseStudyUrl}
                    class="inline-flex items-center gap-2 text-sm text-fg transition-colors group-hover:text-accent after:absolute after:inset-0 after:content-['']"
                  >
                    View case study <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
                {project.liveUrl && (
                  <a
                    href={project.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="relative z-10 inline-flex items-center gap-2 text-sm text-fg-muted transition-colors hover:text-fg"
                  >
                    View live <span aria-hidden="true">&#8599;</span>
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
